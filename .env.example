# Environment Variables — ClickRush
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Database ─────────────────────────────────────────────────
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/clickrush

# ── JWT ──────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-me-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────
# URL of the React dev server (no trailing slash)
FRONTEND_URL=http://localhost:5173
